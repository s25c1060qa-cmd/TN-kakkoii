<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kakkoii_arm</name>
  <version>0.1.0</version>
  <description>CRANE-X7 で決まった位置のブロックをつかみ、受け取った位置に置くピック＆プレースノード</description>
  <maintainer email="kakkoii@todo.todo">TN-kakkoii</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>moveit_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>angles</depend>
  <depend>tf2_geometry_msgs</depend>

  <exec_depend>crane_x7_description</exec_depend>
  <exec_depend>crane_x7_moveit_config</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
